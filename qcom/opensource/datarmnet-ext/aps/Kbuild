ifeq ($(CONFIG_ARCH_CANOE),y)
RMNET_CORE_INC_DIR := $(src)/../../datarmnet/core
KBUILD_EXTRA_SYMBOLS += $(abspath $(obj)/../../datarmnet/Module.symvers)
else ifneq ($(DATARMNET_CORE_PATH),)
